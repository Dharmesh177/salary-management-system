# Backend
PORT=3001
NODE_ENV=development
SQLITE_PATH=./data/salary.db
JWT_SECRET=change-me-in-local-and-production
REGISTRATION_SECRET=change-me-registration-secret
CORS_ORIGIN=http://localhost:5173

# Fail startup if JWT_SECRET or REGISTRATION_SECRET are missing (also enforced when NODE_ENV=production)
REQUIRE_SECRETS=false

# Optional dev-only login seeded with employee data (ignored in production)
DEV_LOGIN_EMAIL=mary.jackson@acme.example
DEV_LOGIN_PASSWORD=password123

# Optional. Leave empty until Q&A is implemented. Never required for unit tests.
LLM_API_KEY=

# Frontend (Vite exposes only VITE_ prefixed vars to the browser)
VITE_API_BASE_URL=

# Backend
PORT=3001
NODE_ENV=development
# Local / Render free tier: relative path under backend/ (ephemeral on free Render)
SQLITE_PATH=./data/salary.db
# Render paid disk only — do NOT use /data/... on Render free tier
# SQLITE_PATH=/data/salary.db
JWT_SECRET=change-me-in-local-and-production
REGISTRATION_SECRET=change-me-registration-secret
CORS_ORIGIN=http://localhost:5173

# Fail startup if JWT_SECRET or REGISTRATION_SECRET are missing (also enforced when NODE_ENV=production)
REQUIRE_SECRETS=false

# Optional dev-only login seeded with employee data (ignored in production)
DEV_LOGIN_EMAIL=mary.jackson@acme.example
DEV_LOGIN_PASSWORD=password123

# Optional stretch feature: Salary Analytics Chat (AWS Bedrock Converse API)
# 1. Enable model access in AWS Bedrock console (e.g. Amazon Nova Lite or Claude Haiku)
# 2. Configure AWS credentials via env vars or ~/.aws/credentials
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_TIMEOUT_MS=30000

# Frontend (Vite exposes only VITE_ prefixed vars to the browser)
VITE_API_BASE_URL=
